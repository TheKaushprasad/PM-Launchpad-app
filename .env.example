# .env.example
GEMINI_API_KEY=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=

# Server-Side Email & Auth (Keep strictly on server)
RESEND_API_KEY=
APP_URL=https://www.thenoobpm.com
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Eval benchmark (optional)
EVAL_JUDGE_MODEL=

# Optional daily caps on AI calls (defaults: 200 per user, 500 per IP)
AI_DAILY_LIMIT_PER_USER=
AI_DAILY_LIMIT_PER_IP=

# AI interview on the live site (local dev always has it). Set to true and redeploy to turn it on.
VITE_AI_INTERVIEW_ENABLED=

# Interview voice (optional; the interview falls back without them)
# Sarvam Bulbul interviewer voice (Indian English); SARVAM_VOICE overrides the default roopa_en_conversational
SARVAM_API_KEY=
SARVAM_VOICE=
# Deepgram Aura-2 interviewer voice (backup when Sarvam fails)
DEEPGRAM_API_KEY=
# Groq Whisper transcription of spoken answers
GROQ_API_KEY=
