# .env.example
GEMINI_API_KEY=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=

# Server-Side Email & Auth (Keep strictly on server)
RESEND_API_KEY=
APP_URL=https://www.thenoobpm.com
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Eval benchmark (optional)
EVAL_JUDGE_MODEL=

# Optional daily caps on AI calls (defaults: 200 per user, 500 per IP)
AI_DAILY_LIMIT_PER_USER=
AI_DAILY_LIMIT_PER_IP=

# Interview voice and video (all optional; the interview falls back without them)
# Deepgram Aura-2 interviewer voice
DEEPGRAM_API_KEY=
# Groq Whisper transcription of spoken answers
GROQ_API_KEY=
# Simli realistic video face (paid per minute after free credit)
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Optional caps on video interviews per day (defaults 2 per user, 20 in total)
SIMLI_DAILY_SESSIONS_PER_USER=
SIMLI_DAILY_SESSIONS_TOTAL=
