rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isOwner(userId) {
      return isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Checks if write payload contains protected evaluation, scoring, rubric, audit, or container fields
    function hasProtectedEvaluationFields() {
      return incoming().keys().hasAny([
        'score', 'overallScore', 'verdict', 'pillar', 'pillars',
        'promptVersion', 'modelId', 'temperature', 'groundingStats',
        'injectionAttempt', 'latencyMs', 'retryCount', 'candidateTurnCount',
        'scoringVersion', 'evaluation', 'result', 'report'
      ]);
    }

    // Connection validation endpoint
    match /test/connection {
      allow read: if true;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Deny public list enumeration

      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // LinkedIn Profile Analyses Sub-collection
      match /analyses/{analysisId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(analysisId);
        allow delete: if isOwner(userId) && isValidId(analysisId);
      }

      // Lesson Progress Sub-collection
      match /progress/{dayId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(dayId);
        allow delete: if isOwner(userId) && isValidId(dayId);
      }

      // Resume Documents Sub-collection (Uploaded CVs & extracted text)
      match /resumes/{resumeId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(resumeId);
        allow delete: if isOwner(userId) && isValidId(resumeId);
      }

      // Real-World Project Submissions Sub-collection
      // Submissions and AI feedback are written server-side via the Firebase Admin SDK.
      // Clients can only read their own submissions.
      match /project_submissions/{projectId} {
        allow get, list: if isOwner(userId);
        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      // Interview Sessions Sub-collection
      // Evaluations, scores, verdicts, rubric pillars, and audit drift-tracking metrics
      // are persisted server-side via the Firebase Admin SDK.
      // Clients can only read their results and cannot create or modify score, verdict, pillar, audit, or report containers.
      match /interview_sessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && !hasProtectedEvaluationFields();
        allow update: if isOwner(userId) && isValidId(sessionId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'score', 'overallScore', 'verdict', 'pillar', 'pillars',
            'promptVersion', 'modelId', 'temperature', 'groundingStats',
            'injectionAttempt', 'latencyMs', 'retryCount', 'candidateTurnCount',
            'scoringVersion', 'evaluation', 'result', 'report'
          ]);
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
    }
  }
}
