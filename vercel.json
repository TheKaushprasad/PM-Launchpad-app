{
  "crons": [
    {
      "path": "/api/jobs/discover",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/jobs/refresh",
      "schedule": "30 0 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/prompts/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
